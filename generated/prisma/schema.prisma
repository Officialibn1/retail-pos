generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expires   DateTime
  createdAt DateTime  @default(now())
  otp       String?
  type      ResetType @default(LINK)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otp])
  @@map("password_reset_tokens")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  username            String               @unique
  name                String
  password            String
  roles               UserRole[]           @default([CASHIER])
  shift               Shift                @default(MORNING)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  status              UserStatus           @default(ACTIVE)
  activityLogs        ActivityLog[]
  passwordResetTokens PasswordResetToken[]
  sales               Sale[]
  saleReturns         SaleReturn[]
  sessions            Session[]

  @@map("users")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  phone     String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([phone, name])
  @@index([createdAt])
  @@map("customers")
}

model InventoryItemCategory {
  id             String          @id @default(cuid())
  name           String          @unique
  inventoryItems InventoryItem[]

  @@map("inventory_item_categories")
}

model InventoryItem {
  id              String                @id @default(cuid())
  name            String
  description     String?
  price           Decimal               @db.Decimal(10, 2)
  stock           Int                   @default(0)
  sku             String                @unique
  barcode         String?               @unique
  categoryId      String
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  category        InventoryItemCategory @relation(fields: [categoryId], references: [id])
  saleItems       SaleItem[]
  saleReturnItems SaleReturnItem[]
  stockMovements  StockMovement[]

  @@index([categoryId])
  @@index([barcode])
  @@index([deletedAt])
  @@index([categoryId, deletedAt])
  @@index([stock, deletedAt])
  @@index([price, stock])
  @@map("inventory_items")
}

model StockMovement {
  id              String        @id @default(cuid())
  inventoryItemId String
  quantity        Int
  reason          String
  notes           String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([createdAt])
  @@index([createdAt, reason])
  @@map("stock_movements")
}

model Sale {
  id             String         @id @default(cuid())
  total          Decimal        @db.Decimal(10, 2)
  status         SaleStatus     @default(PENDING)
  paymentMethod  PaymentMethod?
  amountPaid     Decimal?       @db.Decimal(10, 2)
  changeGiven    Decimal?       @db.Decimal(10, 2)
  completedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  userId         String
  customerId     String?
  discountAmount Int?
  taxAmount      Int?
  subTotal       Decimal        @db.Decimal(10, 2)
  items          SaleItem[]
  returns        SaleReturn[]
  customer       Customer?      @relation(fields: [customerId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
  @@index([customerId, status, createdAt])
  @@index([paymentMethod, status])
  @@index([completedAt])
  @@map("sales")
}

model SaleItem {
  id              String        @id @default(cuid())
  quantity        Int
  price           Decimal       @db.Decimal(10, 2)
  saleId          String
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  sale            Sale          @relation(fields: [saleId], references: [id])

  @@index([inventoryItemId, saleId])
  @@index([quantity, price])
  @@map("sale_items")
}

model SaleReturn {
  id            String           @id @default(cuid())
  saleId        String
  reason        String
  refundAmount  Decimal          @db.Decimal(10, 2)
  refundMethod  PaymentMethod
  processedById String
  createdAt     DateTime         @default(now())
  items         SaleReturnItem[]
  sale          Sale             @relation(fields: [saleId], references: [id])
  processedBy   User             @relation(fields: [processedById], references: [id])

  @@index([saleId])
  @@index([processedById])
  @@index([createdAt])
  @@map("sale_returns")
}

model SaleReturnItem {
  id              String        @id @default(cuid())
  returnId        String
  inventoryItemId String
  quantity        Int
  price           Decimal       @db.Decimal(10, 2)
  saleReturn      SaleReturn    @relation(fields: [returnId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([returnId])
  @@index([inventoryItemId])
  @@map("sale_return_items")
}

model StoreInfo {
  id             String   @id @default("singleton")
  name           String   @default("POS Store")
  address        String   @default("")
  phone          String   @default("")
  email          String?
  taxRate        Decimal  @default(0.1) @db.Decimal(5, 4)
  primaryColor   String   @default("#7c3aed")
  secondaryColor String   @default("#a78bfa")
  logoUrl        String   @default("/pos_logo.png")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("store_info")
}

enum ResetType {
  LINK
  OTP
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  CASHIER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Shift {
  MORNING
  EVENING
  FULLTIME
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}
